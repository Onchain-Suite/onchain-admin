# ═══════════════════════════════════════════════════════════════════════════
# Environment checklist — where each value comes from.
# Copy to .env.local for dev; set the same keys in your host (Vercel → Settings
# → Environment Variables → Production) for deploys.
# ═══════════════════════════════════════════════════════════════════════════

# ── Identity gate (Cloudflare Access) ───────────────────────────────────────
# SOURCE: Cloudflare Zero Trust → Settings → your team domain
#   (<team>.cloudflareaccess.com). Requires a Zero Trust org.
CF_ACCESS_TEAM_DOMAIN=onchainsuite.cloudflareaccess.com
# SOURCE: Zero Trust → Access → Applications → [your admin app] → Overview →
#   "Application Audience (AUD) Tag". Exists only AFTER you create the Access
#   app (README §1). The app verifies the Access JWT against these two.
CF_ACCESS_AUD=replace-with-your-access-application-aud-tag

# ── Authorization ───────────────────────────────────────────────────────────
# SOURCE: you choose. Comma-separated emails permitted to run MUTATING actions
#   (domain resync, wallet credit, plan change, member toggle) — the email each
#   teammate's SSO passes through Access. Default-deny: empty = nobody mutates.
ADMIN_SUPERADMINS=
# SOURCE: you choose (optional). Emails allowed in-app on top of Access. Empty
#   = anyone Access admits (any member of your GitHub org, per the policy).
ADMIN_ALLOWLIST=

# ── Backend (read-only monitoring data) ─────────────────────────────────────
# SOURCE: your backend's API base + /api/v1 — the SAME value the main dashboard
#   uses (from the backend deploy, e.g. Render).
BACKEND_URL=https://onchain-backend-dvxw.onrender.com/api/v1
# SOURCE: a READ-ONLY service token the BACKEND issues (sk_* SecretKeyGuard
#   style), scoped to GET /admin/*. Held server-side only, never in the browser.
#   Does not exist until the backend /admin/* work lands — until then leave
#   blank and keep ADMIN_MOCK=1.
ADMIN_API_TOKEN=replace-with-read-only-service-token

# ── Mode ────────────────────────────────────────────────────────────────────
# SOURCE: you set. 1 = built-in sample data (runs before the backend endpoints
#   exist); 0 = live backend.
ADMIN_MOCK=1

# ── Local development only ──────────────────────────────────────────────────
# No Cloudflare Access sits in front of localhost, so the JWT check would block
# every request. 1 bypasses the gate IN DEV ONLY (ignored when
# NODE_ENV=production). NEVER set this in a deployed environment.
ADMIN_DEV_BYPASS_AUTH=1
