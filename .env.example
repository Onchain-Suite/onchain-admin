# ═══════════════════════════════════════════════════════════════════════════
# Environment checklist — where each value comes from.
# Copy to .env.local for dev; set the same keys in your host (Vercel → Settings
# → Environment Variables → Production) for deploys.
# ═══════════════════════════════════════════════════════════════════════════

# ── Identity gate (GitHub OAuth via Auth.js) ────────────────────────────────
# SOURCE: run `openssl rand -base64 32`. Signs the session cookie. Required.
AUTH_SECRET=replace-with-openssl-rand-base64-32
# SOURCE: create a GitHub OAuth app (github.com/settings/developers, or the org
#   → Settings → Developer settings → OAuth Apps). Callback URLs:
#     https://admin.onchainsuite.com/api/auth/callback/github   (prod)
#     http://localhost:3100/api/auth/callback/github            (dev)
AUTH_GITHUB_ID=replace-with-oauth-app-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-app-client-secret
# SOURCE: your GitHub org slug. Only members of this org can sign in.
ADMIN_GITHUB_ORG=onchainsuite

# ── Authorization (GitHub usernames) ────────────────────────────────────────
# SOURCE: you choose. Comma-separated GitHub usernames permitted to run MUTATING
#   actions (domain resync, wallet credit, plan change). Default-deny: empty =
#   nobody mutates. Everyone else who signs in is read-only.
ADMIN_SUPERADMINS=
# SOURCE: you choose (optional). GitHub usernames allowed in-app beyond org
#   membership. Empty = any org member who signs in.
ADMIN_ALLOWLIST=

# ── Backend (read-only monitoring data) ─────────────────────────────────────
# SOURCE: your backend's API base + /api/v1 — the SAME value the main dashboard
#   uses (from the backend deploy, e.g. Render).
BACKEND_URL=https://onchain-backend-dvxw.onrender.com/api/v1
# SOURCE: a READ-ONLY service token the BACKEND issues (sk_* SecretKeyGuard
#   style), scoped to GET /admin/*. Held server-side only, never in the browser.
#   Does not exist until the backend /admin/* work lands — until then leave
#   blank and keep ADMIN_MOCK=1.
ADMIN_API_TOKEN=replace-with-read-only-service-token

# ── Mode ────────────────────────────────────────────────────────────────────
# SOURCE: you set. 1 = built-in sample data (runs before the backend endpoints
#   exist); 0 = live backend.
ADMIN_MOCK=1

# ── Local development only ──────────────────────────────────────────────────
# 1 bypasses the GitHub sign-in on localhost so you don't need OAuth to run the
# app (ignored when NODE_ENV=production). NEVER set this in a deployment.
ADMIN_DEV_BYPASS_AUTH=1
