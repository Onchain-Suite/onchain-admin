# ── Cloudflare Access (identity) ────────────────────────────────────────────
# Your Zero Trust team domain and the admin Access application's AUD tag.
# The app verifies the Access JWT against these on every request.
CF_ACCESS_TEAM_DOMAIN=onchainsuite.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-access-application-aud-tag

# Optional second gate: comma-separated allowlist of emails permitted in-app.
# Leave empty to allow anyone Cloudflare Access lets through (i.e. any member
# of your GitHub org, per the Access policy).
ADMIN_ALLOWLIST=

# Comma-separated emails permitted to run MUTATING admin actions (domain
# resync, wallet credit, plan change, member toggle). Everyone else is
# read-only. Default-deny: empty means nobody can mutate. (PRD: SUPER_ADMIN.)
ADMIN_SUPERADMINS=

# ── Backend (read-only monitoring data) ─────────────────────────────────────
BACKEND_URL=https://onchain-backend-dvxw.onrender.com/api/v1
# Scoped, READ-ONLY service token the admin app uses to call GET /admin/*.
# Held server-side only; never exposed to the browser.
ADMIN_API_TOKEN=replace-with-read-only-service-token

# ── Local development ───────────────────────────────────────────────────────
# There is no Cloudflare Access in front of localhost, so the JWT check would
# block every request. Set to 1 to bypass the gate IN DEV ONLY (ignored when
# NODE_ENV=production). Never set this in a deployed environment.
ADMIN_DEV_BYPASS_AUTH=1

# Serve built-in sample data instead of calling the backend, so the console
# runs before the GET /admin/* endpoints exist. Set to 0 once they land.
ADMIN_MOCK=1
